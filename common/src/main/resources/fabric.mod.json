{
  "schemaVersion": 1,
  "id": "lyrics3d",
  "version": "${version}",
  "name": "Lyrics3D",
  "description": "Text from your favourite music in Minecraft. Play a song on your PC (Spotify or any Windows media player) and its lyrics float around you in 3D, perfectly in sync, word by word. Classic, Neon and Scattered styles, live editor (Right Shift) and /lyrics commands. Free, by bkubiakdev. Lyrics: lrc.red, LRCLIB, NetEase, Musixmatch.",
  "authors": ["bkubiakdev"],
  "contact": {
    "homepage": "https://bkubiak.dev/mods",
    "sources": "https://github.com/bkubiakdev/Lyrics3D",
    "issues": "https://github.com/bkubiakdev/Lyrics3D/issues"
  },
  "license": "MIT",
  "icon": "assets/lyrics3d/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.bkubiak.lyrics3d.Lyrics3DClient"],
    "modmenu": ["dev.bkubiak.lyrics3d.compat.ModMenuEntry"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${mc_range}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://donate.bkubiak.dev",
        "modmenu.website": "https://bkubiak.dev/mods"
      }
    }
  }
}
